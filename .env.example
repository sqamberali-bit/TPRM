# ── UpGuard CyberRisk API ──────────────────────────────────
UPGUARD_API_KEY=your-upguard-api-key
UPGUARD_BASE_URL=https://cyber-risk.upguard.com/api/public

# ── Entra / Microsoft Graph (SharePoint) ──────────────────
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
SHAREPOINT_SITE_URL=https://yourcouncil.sharepoint.com/sites/VRM
SHAREPOINT_SITE_ID=

# ── Local file paths (for report ingestion) ───────────────
REPORTS_DIR=./input/reports

# ── Operational ───────────────────────────────────────────
DRY_RUN=true
LOG_LEVEL=INFO
